{
  "name": "elite-claude-plugins",
  "private": true,
  "workspaces": [
    "plugins/elite-ts"
  ],
  "scripts": {
    "test": "node --test tests/*.test.js && npm test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "format": "npm run format --workspaces --if-present",
    "format:root": "prettier --write .",
    "format:check:root": "prettier --check .",
    "validate-skill-evals": "node scripts/validate-skill-evals.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.6.0",
    "prettier": "^3.9.4"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  }
}
